import numpy as np

# ============================================================
# 1. 데이터 준비
# ============================================================
# XOR 문제: 입력 2개(x1, x2) -> 출력 1개(y)
# 선형분리가 불가능한 문제 (대각선 배치)이므로 은닉층이 반드시 필요함
X = np.array([[0,0],[0,1],[1,0],[1,1]])   # shape (4, 2): 샘플 4개, 각 샘플은 2차원 입력
y = np.array([[0],[1],[1],[0]])           # shape (4, 1): 각 샘플에 대한 정답(label)

# ============================================================
# 2. 가중치(파라미터) 초기화
# ============================================================
# 신경망이 "학습"한다는 것은 결국 이 W1, b1, W2, b2 숫자들을
# 데이터에 맞게 조금씩 바꿔나가는 것을 의미함
np.random.seed(42)  # 재현성을 위해 난수 시드 고정 (같은 초기값으로 항상 시작)

# W1: 입력층(2개) -> 은닉층(4개)을 연결하는 가중치 행렬
# shape (2, 4) -> 입력 차원 2, 은닉 뉴런 4개
# *0.5는 초기값을 너무 크지 않게 스케일링 (너무 크면 sigmoid가 포화되어 학습이 안 됨)
W1 = np.random.randn(2, 4) * 0.5
b1 = np.zeros((1, 4))   # 은닉층 각 뉴런의 편향(bias), 초기값은 보통 0으로 시작

# W2: 은닉층(4개) -> 출력층(1개)을 연결하는 가중치 행렬
W2 = np.random.randn(4, 1) * 0.5
b2 = np.zeros((1, 1))   # 출력층 편향

# ============================================================
# 3. 활성화 함수 (비선형성을 부여하는 핵심 요소)
# ============================================================
def sigmoid(x):
    # sigmoid(x) = 1 / (1 + e^(-x))
    # 입력을 (0, 1) 사이 값으로 압축 -> 확률처럼 해석 가능
    # 이 비선형 함수가 없으면 아무리 층을 쌓아도 결국 선형 변환의 합 = 하나의 선형 변환과 동일해짐
    # (즉 은닉층이 있어도 XOR을 풀 수 없게 됨)
    return 1 / (1 + np.exp(-x))

def sigmoid_derivative(a):
    # sigmoid 함수의 미분: sigmoid'(x) = sigmoid(x) * (1 - sigmoid(x))
    # 여기서는 이미 sigmoid를 통과한 출력값 a = sigmoid(x)를 인자로 받으므로
    # 다시 계산할 필요 없이 a*(1-a)로 바로 미분값을 구함 (효율적인 트릭)
    # 이 값은 역전파에서 "기울기가 얼마나 흐를 수 있는지"를 결정 (vanishing gradient와 직결)
    return a * (1 - a)

lr = 0.5  # learning rate(학습률): 한 번에 가중치를 얼마나 크게 업데이트할지 결정
          # 너무 크면 발산(진동), 너무 작으면 학습이 느림

# ============================================================
# 4. 학습 루프 (Forward -> Loss -> Backward -> Update 반복)
# ============================================================
for epoch in range(10000):

    # ---------- Forward Pass (순전파) ----------
    # 입력이 신경망을 통과하며 예측값을 만들어내는 과정

    z1 = X @ W1 + b1
    # X @ W1: (4,2) @ (2,4) = (4,4)
    # 각 샘플에 대해 은닉층 4개 뉴런의 "가중합(선형결합)"을 한번에 계산
    # + b1: 각 뉴런에 편향을 더함 (broadcasting으로 4개 샘플 전체에 적용)
    # z1은 아직 활성화 함수를 거치지 않은 "선형" 값 (pre-activation)

    a1 = sigmoid(z1)
    # z1에 비선형성을 적용 -> 은닉층의 실제 출력값 (post-activation)
    # 이 비선형 변환 덕분에 XOR처럼 휘어진 결정 경계를 표현할 수 있게 됨

    z2 = a1 @ W2 + b2
    # a1 @ W2: (4,4) @ (4,1) = (4,1)
    # 은닉층 출력을 다시 가중합하여 출력층의 pre-activation 계산

    a2 = sigmoid(z2)
    # 최종 예측값 (0~1 사이 확률처럼 해석). shape (4,1)

    # ---------- Loss 계산 ----------
    loss = np.mean((y - a2) ** 2)
    # MSE(Mean Squared Error): 예측(a2)과 정답(y)의 차이를 제곱해서 평균
    # 이 하나의 스칼라 값이 "지금 모델이 얼마나 틀렸는가"를 나타냄
    # 학습의 목표는 이 loss를 최소화하는 W1,b1,W2,b2를 찾는 것

    # ---------- Backward Pass (역전파, 체인룰 적용) ----------
    # "loss를 각 가중치로 미분한 값(gradient)"을 뒤에서부터 앞으로 거슬러 계산
    # 이는 미적분의 연쇄법칙(chain rule)을 신경망 구조에 그대로 적용한 것

    d_a2 = (a2 - y)
    # dLoss/da2 : loss(MSE)를 출력 a2에 대해 미분한 값
    # MSE = mean((y-a2)^2) 이므로 미분하면 2*(a2-y)/N 형태지만
    # 상수배는 learning rate에 흡수되므로 여기서는 (a2-y)로 단순화해서 사용

    d_z2 = d_a2 * sigmoid_derivative(a2)
    # dLoss/dz2 = dLoss/da2 * da2/dz2  (체인룰)
    # da2/dz2는 sigmoid의 미분값 -> "출력층에서 얼마나 민감하게 반응하는가"를 반영
    # 원소별 곱(*)인 이유: 각 샘플, 각 출력 뉴런마다 독립적으로 계산되기 때문

    d_W2 = a1.T @ d_z2
    # dLoss/dW2 = a1^T @ dLoss/dz2
    # a1.T: (4,4)^T -> (4,4), d_z2: (4,1)  => 결과 (4,1) = W2와 같은 shape
    # "은닉층 출력(a1)이 클수록, 그 연결의 가중치(W2)가 loss에 더 큰 영향을 준다"는 의미
    # (forward에서 a1 @ W2였던 것의 gradient 버전이 a1.T @ d_z2로 뒤집히는 것에 주목)

    d_b2 = np.sum(d_z2, axis=0, keepdims=True)
    # bias의 gradient는 그냥 해당 방향의 gradient를 전체 샘플에 대해 합산
    # (bias는 모든 샘플에 동일하게 더해지므로, 그 영향력도 전체 샘플에서 누적됨)

    d_a1 = d_z2 @ W2.T
    # dLoss/da1 = dLoss/dz2 @ W2^T
    # "출력층의 오차(d_z2)가 W2를 거꾸로 타고 은닉층까지 전파"되는 과정
    # 이것이 바로 "역"전파(backpropagation)라는 이름의 유래:
    # forward에서 a1->z2로 갔던 경로(W2)를 거슬러서 오차를 되돌려 보냄

    d_z1 = d_a1 * sigmoid_derivative(a1)
    # 은닉층에서도 동일하게 활성화 함수의 미분을 곱해줌
    # 만약 sigmoid_derivative(a1) 값이 매우 작으면(즉 a1이 0이나 1 근처로 포화되면)
    # d_z1도 거의 0이 되어 그 이전 층(W1)으로 gradient가 거의 전달되지 않음
    # -> 이것이 "vanishing gradient(기울기 소실)" 문제의 근본 원인

    d_W1 = X.T @ d_z1
    # dLoss/dW1 = X^T @ dLoss/dz1
    # X.T: (4,2)^T -> (2,4), d_z1: (4,4) => 결과 (2,4) = W1과 같은 shape
    # "입력값(X)이 클수록, 해당 입력을 받는 가중치(W1)가 loss에 더 큰 영향을 준다"

    d_b1 = np.sum(d_z1, axis=0, keepdims=True)
    # 은닉층 편향의 gradient도 동일한 방식으로 계산

    # ---------- 파라미터 업데이트 (경사하강법, Gradient Descent) ----------
    # "기울기(gradient)의 반대 방향"으로 파라미터를 이동시켜 loss를 줄임
    # (gradient는 loss가 가장 가파르게 "증가"하는 방향을 가리키므로, -를 붙여 반대로 이동)
    W2 -= lr * d_W2
    b2 -= lr * d_b2
    W1 -= lr * d_W1
    b1 -= lr * d_b1
    # lr(학습률)만큼만 이동하는 이유: 한 번에 gradient 전체만큼 이동하면
    # loss 곡면이 휘어져 있어 오히려 최소점을 지나쳐버리거나 발산할 수 있음

    # ---------- 진행상황 출력 ----------
    if epoch % 2000 == 0:
        print(f"epoch {epoch}, loss: {loss:.4f}")
        # loss가 0에 가까워질수록 모델이 정답에 가까운 예측을 하고 있다는 뜻

print("\n최종 예측:")
print(a2.round(3))
# 학습이 끝난 후 마지막 forward pass에서 나온 a2 값을 출력
# 0.5를 기준으로 반올림하면 XOR의 실제 정답(0,1,1,0)과 일치해야 정상
